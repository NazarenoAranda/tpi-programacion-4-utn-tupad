# Conexión a la base. PostgreSQL 15 o superior:
DATABASE_URL=postgresql://user:pass@localhost:5432/foodstore_db
# Para desarrollo local sin PostgreSQL se acepta SQLite:
# DATABASE_URL=sqlite:///./foodstore.db

# Firma del JWT (mínimo 32 caracteres)
SECRET_KEY=cambiar-esta-clave-de-al-menos-32-caracteres
ALGORITHM=HS256
# Expiración de la cookie y del token (minutos)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Origen del frontend permitido en CORS (varios separados por coma)
FRONTEND_ORIGIN=http://localhost:5173
